{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":semanticCommitTypeAll(chore)"],
  "timezone": "America/Sao_Paulo",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Next.js e ESLint config sobem juntos",
      "matchPackageNames": ["next", "eslint-config-next"],
      "groupName": "next"
    },
    {
      "description": "Prisma CLI, client, adapter PG e driver juntos",
      "matchPackageNames": ["prisma", "@prisma/**", "pg"],
      "groupName": "prisma"
    },
    {
      "description": "React e tipos React no mesmo PR",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "react"
    },
    {
      "description": "TanStack Query no mesmo PR",
      "matchPackageNames": [
        "@tanstack/react-query",
        "@tanstack/react-query-persist-client",
        "@tanstack/query-async-storage-persister"
      ],
      "groupName": "tanstack-query"
    },
    {
      "description": "TanStack Table isolado (majors quebram a API)",
      "matchPackageNames": ["@tanstack/react-table", "@tanstack/table-core"],
      "groupName": "tanstack-table"
    },
    {
      "description": "Tipos restantes (exceto React, que vai no grupo react)",
      "matchPackageNames": ["@types/**"],
      "excludePackageNames": ["@types/react", "@types/react-dom"],
      "groupName": "types"
    },
    {
      "description": "TS 7 ainda incompatível com typescript-eslint / eslint-config-next",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "ESLint 10 ainda incompatível com eslint-plugin-react do Next",
      "matchPackageNames": ["eslint"],
      "allowedVersions": "<10"
    },
    {
      "description": "Majors isolados — review manual, sem merge automático",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "labels": ["dependencies", "major-update"]
    },
    {
      "description": "Majors de tooling sensíveis — só com aprovação no dashboard",
      "matchPackageNames": ["typescript", "eslint"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "labels": ["dependencies", "major-update", "breaking"]
    }
  ]
}
